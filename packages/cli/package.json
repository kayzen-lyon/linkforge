{
  "name": "@omnillink/cli",
  "version": "0.1.0",
  "description": "The Omnillink link-intelligence API from the command line: metadata, screenshots, PDFs, CSS extraction and readable content.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayzen-lyon/linkforge.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "omnillink": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "omnillink",
    "cli",
    "link-preview",
    "metadata",
    "open-graph",
    "screenshot",
    "pdf",
    "markdown",
    "scraping"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnillink/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
