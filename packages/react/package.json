{
  "name": "@omnillink/react",
  "version": "0.1.0",
  "description": "React bindings for Omnillink: <LinkPreview>, <QrCode>, <OgImage> and hooks over the API (link metadata, technologies, link check, palette…), SSR-safe.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayzen-lyon/linkforge.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "omnillink",
    "react",
    "link-preview",
    "open-graph",
    "metadata",
    "ssr",
    "nextjs",
    "hook",
    "qr-code",
    "og-image"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnillink/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
