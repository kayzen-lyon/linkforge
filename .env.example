# --- Server -----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Set to true when running behind a reverse proxy (rate limiting uses X-Forwarded-For).
TRUST_PROXY=false
# Comma-separated list of allowed CORS origins, or * for any.
CORS_ORIGIN=*

# --- Cache ------------------------------------------------------------------
# Leave empty to use the in-memory LRU cache (single instance only).
REDIS_URL=
CACHE_META_TTL_SECONDS=3600
CACHE_SCREENSHOT_TTL_SECONDS=3600
CACHE_PDF_TTL_SECONDS=3600
CACHE_EXTRACT_TTL_SECONDS=3600
CACHE_CONTENT_TTL_SECONDS=3600
# A request may override these with ?ttl= (60..86400 seconds).
CACHE_MEMORY_MAX_ENTRIES=500

# --- Outbound HTTP fetcher ---------------------------------------------------
HTTP_TIMEOUT_MS=10000
HTTP_MAX_BODY_BYTES=5242880
HTTP_MAX_REDIRECTS=5

# --- Browser pool -------------------------------------------------------------
BROWSER_MAX_CONCURRENCY=4
BROWSER_MAX_QUEUE=50
BROWSER_ACQUIRE_TIMEOUT_MS=15000
BROWSER_MAX_USES=200
BROWSER_NAVIGATION_TIMEOUT_MS=20000
# Use the serverless Chromium build. Auto-detected on Vercel / AWS Lambda; leave unset locally.
# BROWSER_SERVERLESS=false

# --- PDF ----------------------------------------------------------------------
# Largest PDF returned by /pdf; bigger documents fail with ETOOLARGE.
# Defaults to 10485760 (10 MB), or 4194304 (4 MB) on serverless platforms,
# whose response size is capped (4.5 MB on Vercel).
# PDF_MAX_BYTES=10485760

# --- SSRF protection ----------------------------------------------------------
# NEVER enable in production: allows localhost / private IP targets (tests, local dev).
SSRF_ALLOW_PRIVATE_NETWORKS=false
# Comma-separated list of allowed destination ports, or * for any.
SSRF_ALLOWED_PORTS=80,443

# --- Rate limiting ------------------------------------------------------------
# Requests per window without an API key, counted per IP.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- API keys -----------------------------------------------------------------
# Comma-separated keys accepted in the x-api-key header (16-256 characters each,
# e.g. `openssl rand -hex 24`). Leave empty to turn the feature off: the header
# is then ignored. An unknown key is answered with 401.
API_KEYS=
# Requests per window for a valid key, counted per key.
RATE_LIMIT_KEY_MAX=600
